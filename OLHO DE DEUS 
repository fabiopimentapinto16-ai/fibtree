        "\n",
        "    # 10 de TERRAS RARAS\n",
        "    {\"nome\": \"Araxá (MG)\", \"lat\": -19.6, \"lng\": -46.9, \"raio\": 0.12, \"tipo\": \"ETR\", \"facilidade\": \"dificil\"},\n",
        "    {\"nome\": \"Poços de Caldas (MG)\", \"lat\": -21.8, \"lng\": -46.5, \"raio\": 0.15, \"tipo\": \"ETR\", \"facilidade\": \"dificil\"},\n",
