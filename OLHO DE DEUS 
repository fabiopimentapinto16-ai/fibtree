        "        @media(max-width: 768px) {\n",
        "            .sidebar {\n",
        "                width: 100%;\n",
        "                height: 60vh;\n",
        "                top: auto;\n",
        "                bottom: 0;\n",
        "                border-left: none;\n",
        "                border-top: 2px solid var(--cyan);\n",
        "            }\n",
        "            #map {\n",
        "                height: 40vh;\n",
        "            }\n",
        "        }\n",
        "    </style>\n",
        "</head>\n",
        "<body>\n",
        "\n",
        "    <!-- HUD Superior -->\n",
        "    <div class=\"hud-system\">\n",
        "        <div><span class=\"active-dot\"></span>SISTEMA EXPLORADOR ATIVO</div>\n",
        "        <div id=\"hud-gps\">COORD: AGUARDANDO GPS...</div>\n",
        "    </div>\n",
        "\n",
        "    <!-- Mapa Leaflet -->\n",
        "    <div id=\"map\"></div>\n",
        "\n",
        "    <!-- Painel Lateral HUD -->\n",
        "    <div class=\"sidebar\">\n",
        "        <div class=\"header\">\n",
        "            <div class=\"logo\">🛰️</div>\n",
        "            <h1>OLHO DE DEUS</h1>\n",
        "            <div class=\"subtitle\">Prospecção Mineral • Ouro + Terras Raras</div>\n",
        "        </div>\n",
        "\n",
        "        <button class=\"btn-gps\" onclick=\"ativarGPS()\">📍 Ativar GPS em Tempo Real</button>\n",
        "\n",
        "        <div class=\"input-group\">\n",
        "            <input type=\"number\" step=\"any\" id=\"lat-input\" class=\"input-box\" value=\"-6.0\" placeholder=\"Latitude\">\n",
        "            <input type=\"number\" step=\"any\" id=\"lng-input\" class=\"input-box\" value=\"-50.0\" placeholder=\"Longitude\">\n",
        "        </div>\n",
        "\n",
        "        <button onclick=\"analisar()\">🔍 Analisar Potencial</button>\n",
        "        <button onclick=\"carregarSatelite()\">🛰️ Ver Imagem de Satélite</button>\n",
        "\n",
        "        <div class=\"loader\" id=\"loading\"></div>\n",
        "\n",
        "        <!-- Resultado Dinâmico -->\n",
        "        <div class=\"result-panel\" id=\"resultado\">\n",
        "            <div class=\"score-row\">\n",
        "                <div class=\"score-circle\" id=\"score-circ\">\n",
        "                    <span class=\"score-value\" id=\"score-num\">0</span>\n",
        "                    <span style=\"font-size: 9px;\">SCORE</span>\n",
        "                </div>\n",
        "                <div>\n",
        "                    <div class=\"classification\" id=\"classif-txt\">-</div>\n",
        "                    <div style=\"font-size:12px; text-align:right; color:#88a0c0;\" id=\"tipo-principal-txt\">TIPO</div>\n",
        "                </div>\n",
        "            </div>\n",
        "\n",
        "            <div>\n",
        "                <h4 style=\"color: var(--yellow); font-family: 'Orbitron'; margin-bottom: 5px;\">🥇 EVIDÊNCIAS OURO</h4>\n",
        "                <ul class=\"bullet-list gold-list\" id=\"ev-ouro-list\"></ul>\n",
        "            </div>\n",
        "\n",
        "            <div>\n",
        "                <h4 style=\"color: var(--cyan); font-family: 'Orbitron'; margin-bottom: 5px;\">💎 EVIDÊNCIAS TERRAS RARAS</h4>\n",
        "                <ul class=\"bullet-list etr-list\" id=\"ev-etr-list\"></ul>\n",
        "            </div>\n",
        "\n",
        "            <button class=\"btn-gps\" onclick=\"gerarPDF()\">📄 Gerar Relatório PDF</button>\n",
        "        </div>\n",
        "    </div>\n",
        "\n",
        "    <!-- Leaflet JS -->\n",
        "    <script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n",
        "    <script>\n",
        "        let map, marker, radiusCircle;\n",
        "        let dadosUltimaAnalise = null;\n",
        "        let marcadoresPontosProximos = [];\n",
        "        let satLayer = null;\n",
        "\n",
        "        // Inicializa Mapa\n",
        "        function initMap() {\n",
        "            map = L.map('map', { zoomControl: false }).setView([-6.0, -50.0], 5);\n",
        "\n",
        "            // Dark Theme CartoDB\n",
        "            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {\n",
        "                attribution: '&copy; OpenStreetMap contributors &copy; CARTO'\n",
        "            }).addTo(map);\n",
        "        }\n",
        "\n",
        "        window.onload = initMap;\n",
        "\n",
        "        // Ativa Geolocalização Real-Time\n",
        "        function ativarGPS() {\n",
        "            if (\"geolocation\" in navigator) {\n",
        "                navigator.geolocation.watchPosition((pos) => {\n",
        "                    const lat = pos.coords.latitude.toFixed(6);\n",
        "                    const lng = pos.coords.longitude.toFixed(6);\n",
        "\n",
        "                    document.getElementById('lat-input').value = lat;\n",
        "                    document.getElementById('lng-input').value = lng;\n",
        "                    document.getElementById('hud-gps').innerText = `LAT: ${lat} | LNG: ${lng}`;\n",
        "\n",
        "                    // Executa a análise automaticamente ao mudar de posição\n",
        "                    analisar();\n",
        "                }, (err) => {\n",
        "                    alert(\"Erro ao acessar GPS: \" + err.message);\n",
        "                }, { enableHighAccuracy: true });\n",
        "            } else {\n",
        "                alert(\"Geolocalização não suportada neste dispositivo.\");\n",
        "            }\n",
        "        }\n",
        "\n",
        "        // Requisição para a API principal\n",
        "        function analisar() {\n",
        "            const lat = parseFloat(document.getElementById('lat-input').value);\n",
        "            const lng = parseFloat(document.getElementById('lng-input').value);\n",
        "\n",
        "            document.getElementById('loading').style.display = 'block';\n",
        "            document.getElementById('resultado').style.display = 'none';\n",
        "\n",
        "            fetch('/api/analisar', {\n",
        "                method: 'POST',\n",
        "                headers: { 'Content-Type': 'application/json' },\n",
        "                body: JSON.stringify({ lat: lat, lng: lng, usar_satelite: true })\n",
        "            })\n",
        "            .then(res => res.json())\n",
        "            .then(data => {\n",
        "                dadosUltimaAnalise = data;\n",
        "                document.getElementById('loading').style.display = 'none';\n",
        "                renderizarResultado(data);\n",
        "            })\n",
        "            .catch(err => {\n",
        "                document.getElementById('loading').style.display = 'none';\n",
        "                alert(\"Erro de conexão com servidor backend.\");\n",
        "            });\n",
        "        }\n",
        "\n",
        "        // Renderiza Resultados na Tela e adiciona Marcadores\n",
        "        function renderizarResultado(dados) {\n",
        "            document.getElementById('resultado').style.display = 'flex';\n",
        "            document.getElementById('score-num').innerText = dados.score_final;\n",
        "            document.getElementById('classif-txt').innerText = dados.classificacao;\n",
        "\n",
        "            // Ajusta cor da Classificação\n",
        "            const classifTxt = document.getElementById('classif-txt');\n",
        "            classifTxt.className = \"classification\";\n",
        "            if (dados.score_final >= 70) {\n",
        "                classifTxt.style.color = 'var(--green)';\n",
        "            } else if (dados.score_final >= 45) {\n",
        "                classifTxt.style.color = 'var(--yellow)';\n",
        "            } else {\n",
        "                classifTxt.style.color = 'var(--red)';\n",
        "            }\n",
        "\n",
        "            // Tipo Principal\n",
        "            const tipoTxt = document.getElementById('tipo-principal-txt');\n",
        "            if (dados.tipo_principal === \"ouro\") {\n",
        "                tipoTxt.innerHTML = \"OURO 🥇\";\n",
        "                tipoTxt.style.color = \"var(--yellow)\";\n",
        "            } else {\n",
        "                tipoTxt.innerHTML = \"TERRAS RARAS 💎\";\n",
        "                tipoTxt.style.color = \"var(--cyan)\";\n",
        "            }\n",
        "\n",
        "            // Lista de evidências\n",
        "            const evOuroList = document.getElementById('ev-ouro-list');\n",
        "            const evEtrList = document.getElementById('ev-etr-list');\n",
        "            evOuroList.innerHTML = \"\";\n",
        "            evEtrList.innerHTML = \"\";\n",
        "\n",
        "            dados.evidencias_ouro.forEach(ev => {\n",
        "                evOuroList.innerHTML += `<li>${ev}</li>`;\n",
        "            });\n",
        "            if(dados.evidencias_ouro.length === 0) {\n",
        "                evOuroList.innerHTML = \"<li>Nenhuma pista espectral ou depósito de ouro próximo</li>\";\n",
        "            }\n",
        "\n",
        "            dados.evidencias_etr.forEach(ev => {\n",
        "                evEtrList.innerHTML += `<li>${ev}</li>`;\n",
        "            });\n",
        "            if(dados.evidencias_etr.length === 0) {\n",
        "                evEtrList.innerHTML = \"<li>Nenhuma pista espectral ou depósito de ETR próximo</li>\";\n",
        "            }\n",
        "\n",
        "            // Atualiza Marcador no Mapa\n",
        "            const lat = dados.coordenada.lat;\n",
        "            const lng = dados.coordenada.lng;\n",
        "            map.setView([lat, lng], 11);\n",
        "\n",
        "            if (marker) map.removeLayer(marker);\n",
        "            if (radiusCircle) map.removeLayer(radiusCircle);\n",
        "\n",
        "            // Cor do marcador baseada no score\n",
        "            let corScore = \"#ff3355\"; // Vermelho\n",
        "            if (dados.score_final >= 70) corScore = \"#00ff88\";\n",
        "            else if (dados.score_final >= 45) corScore = \"#ffcc00\";\n",
        "\n",
        "            marker = L.circleMarker([lat, lng], {\n",
        "                color: corScore,\n",
        "                radius: 12,\n",
        "                fillOpacity: 0.8\n",
        "            }).addTo(map).bindPopup(`<b>Alvo Principal</b><br>Score: ${dados.score_final}`).openPopup();\n",
        "\n",
        "            radiusCircle = L.circle([lat, lng], {\n",
        "                radius: 15000, // 15 km\n",
        "                color: 'var(--cyan)',\n",
        "                fillOpacity: 0.05,\n",
        "                weight: 1\n",
        "            }).addTo(map);\n",
        "\n",
        "            // Limpar marcadores anteriores\n",
        "            marcadoresPontosProximos.forEach(m => map.removeLayer(m));\n",
        "            marcadoresPontosProximos = [];\n",
        "\n",
        "            // Adiciona pontos próximos\n",
        "            dados.pontos_proximos.forEach(pt => {\n",
        "                // Procura a coordenada correta do ponto cadastrado para fins estéticos\n",
        "                let corPonto = pt.tipo === \"ouro\" ? \"var(--yellow)\" : \"var(--cyan)\";\n",
        "                // Adiciona marcadores de Prioridade Máxima com 'X'\n",
        "                let customIcon = L.divIcon({\n",
        "                    className: 'custom-div-icon',\n",
        "                    html: `<div style='color: ${corPonto}; font-weight: bold; font-size: 16px; text-shadow: 0 0 3px black;'>✕</div>`,\n",
        "                    iconSize: [20, 20],\n",
        "                    iconAnchor: [10, 10]\n",
        "                });\n",
        "\n",
        "                // Encontra lat/lng das regiões\n",
        "                // Para demonstração simples, aplicamos pequenas variações fictícias ao redor do ponto\n",
        "                const ptMarker = L.marker([lat + (Math.random() - 0.5) * 0.1, lng + (Math.random() - 0.5) * 0.1], {\n",
        "                    icon: customIcon\n",
        "                }).addTo(map).bindPopup(`<b>${pt.nome}</b><br>Tipo: ${pt.tipo.toUpperCase()}<br>Distância: ${pt.distancia} km`);\n",
        "\n",
        "                marcadoresPontosProximos.push(ptMarker);\n",
        "            });\n",
        "        }\n",
        "\n",
        "        // Ativa Camada do satélite NASA GIBS no Mapa\n",
        "        function carregarSatelite() {\n",
        "            if (satLayer) {\n",
        "                map.removeLayer(satLayer);\n",
        "                satLayer = null;\n",
        "                alert(\"Camada NASA GIBS desativada.\");\n",
        "                return;\n",
        "            }\n",
        "\n",
        "            // Adicionando camada oficial GIBS\n",
        "            satLayer = L.tileLayer('https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/MODIS_Terra_CorrectedReflectance_TrueColor/default/{time}/GoogleMapsCompatible_Level9/{z}/{y}/{x}.jpg', {\n",
        "                time: '2023-10-01', // Data estática padrão\n",
        "                maxZoom: 9,\n",
        "                opacity: 0.75,\n",
        "                attribution: 'NASA/GIBS'\n",
        "            }).addTo(map);\n",
        "\n",
        "            alert(\"Camada de satélite NASA GIBS ativada!\");\n",
        "        }\n",
        "\n",
        "        // Faz o Download do PDF do Relatório\n",
        "        function gerarPDF() {\n",
        "            if (!dadosUltimaAnalise) return;\n",
        "\n",
        "            fetch('/api/gerar-pdf', {\n",
        "                method: 'POST',\n",
        "                headers: { 'Content-Type': 'application/json' },\n",
        "                body: JSON.stringify(dadosUltimaAnalise)\n",
        "            })\n",
        "            .then(res => res.blob())\n",
        "            .then(blob => {\n",
        "                const url = window.URL.createObjectURL(blob);\n",
        "                const a = document.createElement('a');\n",
        "                a.href = url;\n",
        "                a.download = `Relatorio_Olho_Deus_${dadosUltimaAnalise.score_final}.pdf`;\n",
        "                document.body.appendChild(a);\n",
        "                a.click();\n",
        "                a.remove();\n",
        "            })\n",
        "            .catch(err => alert(\"Erro ao gerar PDF: \" + err));\n",
        "        }\n",
        "    </script>\n",
        "</body>\n",
        "</html>"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
