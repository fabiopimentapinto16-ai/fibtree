        "%%writefile olho-de-deus/backend/app.py\n",
        "import os\n",
        "import sys\n",
        "from flask import Flask, request, jsonify, send_file\n",
        "from flask_cors import CORS\n",
        "\n",
        "# Permite importar do diretório local\n",
        "sys.path.append(os.path.dirname(os.path.abspath(__file__)))\n",
        "\n",
        "from regras import calcular_score\n",
        "from satelite import SateliteGIBS\n",
        "from pdf_generator import gerar_pdf\n",
        "\n",
        "app = Flask(__name__)\n",
        "CORS(app)\n",
        "\n",
        "@app.route('/')\n",
        "def index():\n",
        "    # Servindo o index.html a partir do diretório frontend\n",
        "    frontend_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'frontend', 'index.html')\n",
        "    if os.path.exists(frontend_path):\n",
        "        with open(frontend_path, 'r', encoding='utf-8') as f:\n",
        "            return f.read()\n",
        "    return \"Frontend index.html não encontrado no diretório /frontend.\", 404\n",
        "\n",
        "@app.route('/api/analisar', methods=['POST'])\n",
        "def analisar():\n",
        "    dados = request.get_json() or {}\n",
        "    lat = float(dados.get('lat', -6.0))\n",
        "    lng = float(dados.get('lng', -50.0))\n",
        "    usar_satelite = dados.get('usar_satelite', True)\n",
        "\n",
        "    dados_sat = None\n",
        "    if usar_satelite:\n",
        "        try:\n",
        "            dados_sat = SateliteGIBS().extrair_dados_espectrais(lat, lng)\n",
        "        except Exception as e:\n",
        "            print(f\"Erro ao processar satélite: {e}\")\n",
        "\n",
        "    resultado = calcular_score(lat, lng, dados_sat)\n",
        "\n",
        "    # Adiciona os índices espectrais no resultado final para exibição e PDF\n",
        "    if dados_sat:\n",
        "        resultado['dados_satelite'] = dados_sat\n",
        "\n",
        "    return jsonify(resultado)\n",
        "\n",
        "@app.route('/api/gerar-pdf', methods=['POST'])\n",
        "def baixar_pdf():\n",
        "    analise = request.get_json()\n",
        "    if not analise:\n",
        "        return jsonify({\"error\": \"Dados ausentes\"}), 400\n",
        "\n",
        "    try:\n",
        "        caminho_pdf = gerar_pdf(analise)\n",
        "        return send_file(caminho_pdf, as_attachment=True, download_name=\"relatorio_olho_deus.pdf\")\n",
        "    except Exception as e:\n",
        "        return jsonify({\"error\": str(e)}), 500\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    app.run(host='0.0.0.0', port=5000, debug=True)"
