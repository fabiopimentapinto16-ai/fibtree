        "        classificacao = \"BAIXO POTENCIAL\"\n",
        "    else:\n",
        "        classificacao = \"SEM INDÍCIOS\"\n",
        "\n",
        "    return {\n",
        "        \"score_final\": score_final,\n",
        "        \"classificacao\": classificacao,\n",
        "        \"tipo_principal\": tipo_principal,\n",
        "        \"score_ouro\": score_ouro,\n",
