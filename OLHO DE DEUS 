        "# 2. Criando o projeto híbrido Cordova e injetando o Frontend responsivo\n",
        "import shutil\n",
        "\n",
        "# Remove diretório móvel se já existir para limpeza\n",
        "if os.path.exists('olho-de-deus-mobile'):\n",
        "    shutil.rmtree('olho-de-deus-mobile')\n",
        "\n",
        "# Cria novo app híbrido\n",
        "!cordova create olho-de-deus-mobile com.olhodedeus.app \"OlhoDeDeus\"\n",
        "\n",
        "# Copia o frontend web para a pasta de distribuição do app móvel\n",
        "shutil.copy('olho-de-deus/frontend/index.html', 'olho-de-deus-mobile/www/index.html')\n",
        "\n",
        "print(\"Projeto móvel híbrido estruturado com sucesso!\")"
