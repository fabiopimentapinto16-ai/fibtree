        "%%writefile olho-de-deus/backend/analise_espectral.py\n",
        "def calcular_band_ratios(bandas):\n",
        "    \"\"\"\n",
        "    Recebe dict com bandas Sentinel-2 (b2, b3, b4, b8, b11, b12)\n",
        "    e calcula índices normalizados de 0 a 1.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        b2 = float(bandas.get('b2', 1))\n",
        "        b3 = float(bandas.get('b3', 1))\n",
        "        b4 = float(bandas.get('b4', 1))\n",
        "        b8 = float(bandas.get('b8', 1))\n",
        "        b11 = float(bandas.get('b11', 1))\n",
        "        b12 = float(bandas.get('b12', 1))\n",
        "\n",
        "        # Evita divisão por zero\n",
        "        oxido_ferro = b4 / b2 if b2 != 0 else 0\n",
        "        argila = b11 / b12 if b12 != 0 else 0\n",
        "        carbonato = b11 / b8 if b8 != 0 else 0\n",
        "        gossan = (b4 + b3) / b2 if b2 != 0 else 0\n",
        "\n",
        "        # Normalização simples limitando teto e dividindo para intervalo 0-1\n",
        "        norm = lambda val, max_val: min(max(val / max_val, 0.0), 1.0)\n",
        "\n",
        "        return {\n",
        "            'oxido_ferro': norm(oxido_ferro, 3.0),\n",
        "            'argila': norm(argila, 3.0),\n",
        "            'carbonato': norm(carbonato, 3.0),\n",
        "            'gossan': norm(gossan, 3.0)\n",
        "        }\n",
        "    except Exception as e:\n",
        "        return {\n",
        "            'oxido_ferro': 0.0,\n",
        "            'argila': 0.0,\n",
        "            'carbonato': 0.0,\n",
        "            'gossan': 0.0\n",
        "        }\n",
        "\n",
        "def classificar_anomalia(valor):\n",
        "    if valor > 0.7: return \"ALTA\"\n",
        "    if valor > 0.4: return \"MODERADA\"\n",
        "    if valor > 0.2: return \"BAIXA\"\n",
        "    return \"AUSENTE\""
