        "%%writefile olho-de-deus/backend/satelite.py\n",
        "import datetime\n",
        "import requests\n",
        "from io import BytesIO\n",
        "from PIL import Image\n",
        "import numpy as np\n",
        "\n",
        "class SateliteGIBS:\n",
        "    def __init__(self):\n",
        "        self.base_url = \"https://gibs.earthdata.nasa.gov/wmts/epsg3857/best\"\n",
        "        self.camadas = {\n",
        "            \"modis_terra\": \"MODIS_Terra_CorrectedReflectance_TrueColor\",\n",
        "            \"modis_aqua\": \"MODIS_Aqua_CorrectedReflectance_TrueColor\",\n",
        "            \"viirs\": \"VIIRS_SNPP_CorrectedReflectance_TrueColor\"\n",
        "        }\n",
        "\n",
        "    def _lat_lng_para_tile(self, lat, lng, zoom):\n",
        "        import math\n",
        "        lat_rad = math.radians(lat)\n",
        "        n = 2.0 ** zoom\n",
        "        xtile = int((lng + 180.0) / 360.0 * n)\n",
        "        ytile = int((1.0 - math.log(math.tan(lat_rad) + (1 / math.cos(lat_rad))) / math.pi) / 2.0 * n)\n",
        "        return xtile, ytile\n",
        "\n",
        "    def buscar_imagem(self, lat, lng, data=None, zoom=8, camada=\"modis_terra\"):\n",
        "        if data is None:\n",
        "            # Ontem por padrão\n",
        "            ontem = datetime.date.today() - datetime.timedelta(days=1)\n",
        "            data = ontem.strftime(\"%Y-%m-%d\")\n",
        "\n",
        "        x, y = self._lat_lng_para_tile(lat, lng, zoom)\n",
        "        layer = self.camadas.get(camada, self.camadas[\"modis_terra\"])\n",
        "\n",
        "        url = f\"{self.base_url}/{layer}/default/{data}/GoogleMapsCompatible_Level9/{zoom}/{y}/{x}.jpg\"\n",
        "\n",
        "        try:\n",
        "            response = requests.get(url, timeout=10)\n",
        "            if response.status_code == 200:\n",
        "                return Image.open(BytesIO(response.content)), data\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "        # Retorna imagem cinza fake se falhar a conexão com a API da NASA\n",
        "        img_fake = Image.new(\"RGB\", (256, 256), color=(128, 128, 128))\n",
        "        return img_fake, data\n",
        "\n",
        "    def extrair_dados_espectrais(self, lat, lng):\n",
        "        img, data_imagem = self.buscar_imagem(lat, lng)\n",
        "        arr = np.array(img, dtype=np.float32)\n",
        "\n",
        "        # Separa bandas R, G, B\n",
        "        R = arr[:, :, 0]\n",
        "        G = arr[:, :, 1]\n",
        "        B = arr[:, :, 2]\n",
        "\n",
        "        # Cálculos de índices baseados nas regras de negócio informadas\n",
        "        denom_ferro = R + B\n",
        "        denom_ferro[denom_ferro == 0] = 1\n",
        "        oxido_ferro_arr = (R - B) / denom_ferro\n",
        "        oxido_ferro = float(np.clip(np.mean(oxido_ferro_arr), 0, 1))\n",
        "\n",
        "        denom_carb = G + R * 0.5\n",
        "        denom_carb[denom_carb == 0] = 1\n",
        "        carbonato_argila_arr = (G - R * 0.5) / denom_carb\n",
        "        carbonato_argila = float(np.clip(np.mean(carbonato_argila_arr), 0, 1))\n",
        "\n",
        "        anomalia_radioativa = float(np.clip(np.std(arr) / 255.0, 0, 1))\n",
        "\n",
        "        return {\n",
        "            \"oxido_ferro\": round(oxido_ferro, 4),\n",
        "            \"carbonato_argila\": round(carbonato_argila, 4),\n",
        "            \"anomalia_radioativa\": round(anomalia_radioativa, 4),\n",
        "            \"data_imagem\": data_imagem,\n",
        "            \"resolucao\": \"250m (MODIS)\"\n",
        "        }"
      ],
