        "    {\"nome\": \"Pacaraima (RR)\", \"lat\": 4.4, \"lng\": -61.1, \"raio\": 0.1, \"tipo\": \"ouro\", \"facilidade\": \"media\"},\n",
        "    {\"nome\": \"Uiramutã (RR)\", \"lat\": 4.6, \"lng\": -60.2, \"raio\": 0.12, \"tipo\": \"ouro\", \"facilidade\": \"dificil\"},\n",
